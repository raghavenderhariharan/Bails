# Copy to .env for local use (never commit the real .env).
# config.py loads this file automatically via python-dotenv.
# Real environment variables always take precedence over anything set here.

# Password for the single admin login.
ADMIN_PASSWORD=Admin123

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If you leave this unset locally, a stable key is created at
# instance/secret_key. Deployments (anything with DATABASE_URL set) must set it.
SECRET_KEY=change-me-to-a-long-random-string

# Leave unset to use the local SQLite file at instance/bails_ledger.db.
# Render fills this in automatically when you use render.yaml.
# DATABASE_URL=postgresql://user:pass@host:5432/bails_ledger

# Set to true when served over HTTPS so the session cookie is marked Secure.
FORCE_HTTPS=false

# How many reverse proxies sit in front of the app. Render uses 1.
# Keep 0 for local runs: at 0, X-Forwarded-* headers are ignored, so a forged
# header can never be used to reset the login throttle.
TRUSTED_PROXY_COUNT=0

# Currency symbol shown throughout the UI.
CURRENCY_SYMBOL=₹

# ---- "Send mail" (optional; leave blank and the dialog offers "Open in Gmail") ----
# Option 1, works everywhere incl. Render free: Gmail API. Run `python gmail_auth.py`.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# Option 2, local / paid Render only (free Render blocks SMTP): a Gmail app password.
# SMTP_USER=bailscricketground@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_FROM_NAME=Bail's Cricket Ground
